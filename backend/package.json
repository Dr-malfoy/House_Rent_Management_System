{
  "name": "smart-house-rent-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Web-Based Smart House Rent Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node database/migrate.js --setup",
    "db:seed": "node database/migrate.js --seed",
    "db:init": "node database/migrate.js --all",
    "db:bench": "node database/generate_seed.js",
    "test:spatial": "node tests/spatial_test.js"
  },
  "keywords": [
    "house-rent",
    "real-estate",
    "spatial",
    "mysql",
    "express"
  ],
  "author": "Uttara University CSE Dept",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
